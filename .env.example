# Resend transactional email (https://resend.com/api-keys)
RESEND_API_KEY=
# Verified sender on your Resend domain
CONTACT_FROM_EMAIL="Nash Construction <estimates@nashconstructionnh.com>"
# Where new consultation requests are delivered
CONTACT_TO_EMAIL=steve@nashconstructionnh.com
# Canonical site origin, used for metadata + JSON-LD
NEXT_PUBLIC_SITE_URL=https://www.nashconstructionnh.com

# ── Website editor (/admin) ───────────────────────────────────────────────────
# A GitHub OAuth app, used only to sign editors in to /admin. Create one at
# https://github.com/settings/developers with:
#   Homepage URL:               https://www.nashconstructionnh.com
#   Authorization callback URL: https://www.nashconstructionnh.com/api/callback
# Without these the site runs exactly as before; only /admin stops working.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
